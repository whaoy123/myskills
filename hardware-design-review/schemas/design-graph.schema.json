{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Hardware Review DesignGraph",
  "type": "object",
  "required": ["schema_version", "nodes", "edges"],
  "properties": {
    "schema_version": {"const": 1},
    "nodes": {"type": "array", "items": {"type": "object", "required": ["id", "type"], "properties": {"id": {"type": "string"}, "type": {"enum": ["component", "pin", "net", "functional_block", "power_domain", "ground_domain", "isolation_domain", "pcb_region"]}, "attributes": {"type": "object"}}}},
    "edges": {"type": "array", "items": {"type": "object", "required": ["from", "to", "relation"], "properties": {"from": {"type": "string"}, "to": {"type": "string"}, "relation": {"type": "string"}, "attributes": {"type": "object"}}}}
  }
}
